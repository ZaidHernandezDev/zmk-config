#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        backtick_macro: backtick_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(BACKSLASH) &kp SPACE>;
            label = "BACKTICK_MACRO";
        };

        potencia_macro: potencia_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(SINGLE_QUOTE) &kp SPACE>;
            label = "POTENCIA_MACRO";
        };
    };

    combos {
        compatible = "zmk,combos";

        RESET_SYS {
            bindings = <&sys_reset>;
            key-positions = <0 11>;
            layers = <3>;
        };

        CLR_ALL_BT {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <5 6>;
            layers = <3>;
        };

        qwerty {
            bindings = <&to 4>;
            key-positions = <38 39>;
            layers = <3>;
        };

        DVORAK {
            bindings = <&to 0>;
            key-positions = <37 40>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Dvorak {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp LEFT_BRACKET  &kp COMMA  &kp DOT    &kp P  &kp Y        &kp F    &kp G  &kp C         &kp R  &kp L  &kp BACKSPACE
&kp TAB     &kp A             &kp O      &kp E      &kp U  &kp I        &kp D    &kp H  &kp T         &kp N  &kp S  &kp LEFT_ALT
&kp LSHFT   &kp SEMI          &kp Q      &kp J      &kp K  &kp X        &kp B    &kp M  &kp W         &kp V  &kp Z  &kp RIGHT_ALT
                                         &kp LCTRL  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp LEFT_WIN
            >;

            label = "DVK";
        };

        numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE  &none      &kp SQT           &kp BACKSLASH      &kp NON_US_BSLH  &none        &none    &kp N7  &kp N8        &kp N9        &none  &kp BACKSPACE
&kp TAB     &none      &kp EQUAL         &kp MINUS          &kp GRAVE        &none        &kp N0   &kp N4  &kp N5        &kp NUMBER_6  &none  &kp LEFT_ALT
&kp LSHFT   &kp LCTRL  &kp LS(NUMBER_1)  &kp RIGHT_BRACKET  &kp SLASH        &kp SPACE    &none    &kp N1  &kp N2        &kp N3        &none  &kp RIGHT_ALT
                                         &none              &trans           &none        &kp RET  &trans  &kp LEFT_WIN
            >;

            label = "NUM";
        };

        nav_media {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE  &none         &none         &none             &none            &kp PRINTSCREEN    &kp INS    &kp HOME      &kp END         &kp PAGE_UP   &kp PAGE_DOWN  &kp BACKSPACE
&caps_word  &kp CAPSLOCK  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT       &none              &none      &kp LEFT      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT      &kp LEFT_ALT
&kp LSHFT   &none         &kp C_VOL_DN  &kp C_MUTE        &kp C_VOLUME_UP  &none              &kp ENTER  &kp LEFT_WIN  &none           &none         &none          &kp RIGHT_ALT
                                        &kp LCTRL         &trans           &kp SPACE          &none      &trans        &none
            >;

            label = "NAV";
        };

        system {
            bindings = <
&none      &none         &none         &none         &none         &none           &none  &kp F9  &kp F10   &kp F11  &kp F12  &none
&none      &none         &none         &none         &none         &bt BT_CLR      &none  &kp F5  &kp F6    &kp F7   &kp F8   &kp LEFT_ALT
&kp LSHFT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &kp F1  &kp F2    &kp F3   &kp F4   &kp RIGHT_ALT
                                       &kp LCTRL     &trans        &none           &none  &trans  &kp LWIN
            >;

            label = "SYS";
        };

        QWERTY {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D      &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp LALT
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RALT
                         &kp LCTRL  &none  &kp SPACE    &kp ENTER  &none  &kp LGUI
            >;

            label = "QWERTY";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_f_layer_activate {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
